<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  
  <title>Personalized Workout Plan - MX.Core</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      min-height: 100vh;
      background: linear-gradient(135deg, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0.4) 100%), url('https://images.unsplash.com/photo-1534438327276-14e5300c3a48?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1920&q=80');
      background-size: cover;
      background-position: center;
      background-attachment: fixed;
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      padding: 20px;
    }

    .container {
      text-align: center;
      z-index: 10;
      max-width: 900px;
      width: 100%;
      padding: 40px;
      backdrop-filter: blur(10px);
      background: rgba(255, 255, 255, 0.1);
      border-radius: 24px;
      border: 1px solid rgba(255, 255, 255, 0.2);
      box-shadow: 0 25px 50px rgba(0, 0, 0, 0.3);
      animation: fadeInUp 1s ease-out;
    }

    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(30px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .logo {
      font-size: 3rem;
      margin-bottom: 10px;
      animation: pulse 2s infinite;
    }

    @keyframes pulse {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.05); }
    }

    h1 {
      font-size: 2.8rem;
      font-weight: 800;
      margin-bottom: 20px;
      background: linear-gradient(135deg, #fff 0%, #f0f0f0 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      line-height: 1.2;
      text-shadow: 0 4px 8px rgba(0, 0, 0, 0.3);
    }

    .subtitle {
      font-size: 1.2rem;
      margin-bottom: 40px;
      color: rgba(255, 255, 255, 0.9);
      font-weight: 300;
      line-height: 1.6;
      max-width: 600px;
      margin-left: auto;
      margin-right: auto;
    }

    .form-box {
      background: rgba(255, 255, 255, 0.1);
      border-radius: 20px;
      padding: 35px 30px;
      margin-bottom: 30px;
      border: 1px solid rgba(255, 255, 255, 0.2);
      backdrop-filter: blur(5px);
      text-align: left;
    }

    .form-section {
      margin-bottom: 25px;
    }

    .form-section:last-of-type {
      margin-bottom: 25px;
    }

    .form-section > label {
      font-size: 1.2rem;
      font-weight: 600;
      color: rgba(255, 255, 255, 0.95);
      display: block;
      margin-bottom: 15px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    select, input[type="number"] {
      width: 100%;
      padding: 15px 20px;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.2);
      border-radius: 12px;
      color: white;
      font-size: 1.1rem;
      font-weight: 500;
      transition: all 0.3s ease;
      appearance: none;
    }

    select:focus, input[type="number"]:focus {
      outline: none;
      background: rgba(255, 255, 255, 0.1);
      border-color: rgba(255, 107, 107, 0.5);
      box-shadow: 0 0 0 3px rgba(255, 107, 107, 0.2);
    }

    select option {
      background: #2c3e50;
      color: white;
    }

    input[type="number"]::placeholder {
      color: rgba(255, 255, 255, 0.5);
    }

    .checkbox-group {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 12px;
      margin-top: 15px;
    }

    .checkbox-label {
      display: flex;
      align-items: center;
      padding: 15px 20px;
      background: rgba(255, 255, 255, 0.05);
      border-radius: 12px;
      border: 1px solid rgba(255, 255, 255, 0.1);
      transition: all 0.3s ease;
      cursor: pointer;
      position: relative;
      overflow: hidden;
      font-size: 1rem;
      font-weight: 500;
      color: rgba(255, 255, 255, 0.9);
    }

    .checkbox-label:hover {
      background: rgba(255, 255, 255, 0.1);
      border-color: rgba(255, 107, 107, 0.3);
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
    }

    input[type="checkbox"] {
      width: 18px;
      height: 18px;
      margin-right: 12px;
      cursor: pointer;
      appearance: none;
      border: 2px solid rgba(255, 255, 255, 0.4);
      border-radius: 4px;
      background: transparent;
      position: relative;
      transition: all 0.3s ease;
    }

    input[type="checkbox"]:checked {
      background: linear-gradient(135deg, #ff6b6b 0%, #ee5a24 100%);
      border-color: #ff6b6b;
    }

    input[type="checkbox"]:checked::after {
      content: '✓';
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      color: white;
      font-size: 11px;
      font-weight: bold;
    }

    .btn {
      background: linear-gradient(135deg, #ff6b6b 0%, #ee5a24 100%);
      color: white;
      padding: 18px 50px;
      border: none;
      border-radius: 50px;
      font-size: 1.2rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
      text-transform: uppercase;
      letter-spacing: 1px;
      box-shadow: 0 15px 30px rgba(255, 107, 107, 0.4);
      position: relative;
      overflow: hidden;
      width: 100%;
      max-width: 300px;
      margin: 25px auto 0;
      display: block;
    }

    .btn:hover {
      transform: translateY(-3px) scale(1.05);
      box-shadow: 0 20px 40px rgba(255, 107, 107, 0.6);
      background: linear-gradient(135deg, #ff5252 0%, #d63031 100%);
    }

    .workout-plan {
      background: rgba(255, 255, 255, 0.15);
      border-radius: 20px;
      padding: 30px;
      margin-top: 30px;
      border: 1px solid rgba(255, 255, 255, 0.2);
      backdrop-filter: blur(10px);
      animation: slideInUp 0.6s ease-out;
      text-align: left;
      display: none;
    }

    @keyframes slideInUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .workout-plan h2 {
      font-size: 2rem;
      font-weight: 700;
      margin-bottom: 20px;
      background: linear-gradient(135deg, #ff6b6b 0%, #ee5a24 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      text-align: center;
    }

    .workout-section {
      margin-bottom: 25px;
      padding: 20px;
      background: rgba(255, 255, 255, 0.05);
      border-radius: 15px;
      border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .workout-section h3 {
      font-size: 1.3rem;
      font-weight: 600;
      margin-bottom: 15px;
      color: #ff6b6b;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .exercise-item {
      padding: 12px 15px;
      margin: 8px 0;
      background: rgba(255, 255, 255, 0.08);
      border-radius: 10px;
      border-left: 4px solid #ff6b6b;
      font-size: 1rem;
      color: rgba(255, 255, 255, 0.95);
    }

    .exercise-name {
      font-weight: 600;
      color: white;
    }

    .exercise-details {
      font-size: 0.9rem;
      color: rgba(255, 255, 255, 0.8);
      margin-top: 5px;
    }

    .plan-summary {
      background: rgba(255, 107, 107, 0.1);
      border: 1px solid rgba(255, 107, 107, 0.3);
      border-radius: 15px;
      padding: 20px;
      margin-bottom: 25px;
      text-align: center;
    }

    .plan-summary h3 {
      color: #ff6b6b;
      font-size: 1.4rem;
      margin-bottom: 10px;
    }

    .plan-summary p {
      color: rgba(255, 255, 255, 0.9);
      font-size: 1.1rem;
    }

    /* Floating particles animation */
    .particle {
      position: absolute;
      background: rgba(255, 255, 255, 0.1);
      border-radius: 50%;
      pointer-events: none;
      animation: float 6s ease-in-out infinite;
    }

    @keyframes float {
      0%, 100% { transform: translateY(0px) rotate(0deg); }
      50% { transform: translateY(-20px) rotate(180deg); }
    }

    .particle:nth-child(1) { top: 20%; left: 20%; width: 10px; height: 10px; animation-delay: 0s; }
    .particle:nth-child(2) { top: 80%; left: 80%; width: 15px; height: 15px; animation-delay: 2s; }
    .particle:nth-child(3) { top: 40%; left: 70%; width: 8px; height: 8px; animation-delay: 4s; }

    /* Mobile Responsiveness */
    @media (max-width: 768px) {
      body {
        background-attachment: scroll;
        padding: 10px;
        align-items: flex-start;
        padding-top: 40px;
      }
      
      .container {
        padding: 30px 25px;
        border-radius: 20px;
      }
      
      .logo {
        font-size: 2.5rem;
      }
      
      h1 {
        font-size: 2.2rem;
      }
      
      .subtitle {
        font-size: 1.1rem;
        margin-bottom: 30px;
      }

      .checkbox-group {
        grid-template-columns: 1fr;
      }

      .workout-plan {
        padding: 20px;
      }

      .workout-plan h2 {
        font-size: 1.6rem;
      }
    }

    @media (max-width: 480px) {
      .container {
        padding: 25px 20px;
      }
      
      .logo {
        font-size: 2rem;
      }
      
      h1 {
        font-size: 1.8rem;
      }
      
      .subtitle {
        font-size: 1rem;
      }

      .form-box {
        padding: 25px 20px;
      }

      .workout-section {
        padding: 15px;
      }
    }
  </style>
</head>
<body>
  <!-- Floating particles -->
  <div class="particle"></div>
  <div class="particle"></div>
  <div class="particle"></div>

  <div class="container">
    <div class="logo">🏋️‍♂️</div>
    <h1>Personalized Workout Plan</h1>
    <p class="subtitle">Get a customized workout plan tailored to your fitness level, goals, and available equipment.</p>

    <form class="form-box" id="workoutForm">
      <div class="form-section">
        <label>Fitness Level</label>
        <select id="fitnessLevel" required>
          <option value="">Select your current fitness level</option>
          <option value="beginner">Beginner (New to exercise)</option>
          <option value="intermediate">Intermediate (6 months+ experience)</option>
          <option value="advanced">Advanced (2+ years experience)</option>
        </select>
      </div>

      <div class="form-section">
        <label>Primary Goals</label>
        <div class="checkbox-group">
          <label class="checkbox-label">
            <input type="checkbox" name="goals" value="weight_loss">
            <span>⚖️ Weight Loss</span>
          </label>
          <label class="checkbox-label">
            <input type="checkbox" name="goals" value="muscle_gain">
            <span>💪 Muscle Gain</span>
          </label>
          <label class="checkbox-label">
            <input type="checkbox" name="goals" value="strength">
            <span>🏋️‍♀️ Build Strength</span>
          </label>
          <label class="checkbox-label">
            <input type="checkbox" name="goals" value="endurance">
            <span>🏃‍♂️ Improve Endurance</span>
          </label>
          <label class="checkbox-label">
            <input type="checkbox" name="goals" value="flexibility">
            <span>🧘‍♀️ Flexibility</span>
          </label>
          <label class="checkbox-label">
            <input type="checkbox" name="goals" value="general_fitness">
            <span>❤️ General Fitness</span>
          </label>
        </div>
      </div>

      <div class="form-section">
        <label>Available Equipment</label>
        <div class="checkbox-group">
          <label class="checkbox-label">
            <input type="checkbox" name="equipment" value="none">
            <span>🏠 No Equipment (Bodyweight)</span>
          </label>
          <label class="checkbox-label">
            <input type="checkbox" name="equipment" value="dumbbells">
            <span>🏋️ Dumbbells</span>
          </label>
          <label class="checkbox-label">
            <input type="checkbox" name="equipment" value="resistance_bands">
            <span>🔗 Resistance Bands</span>
          </label>
          <label class="checkbox-label">
            <input type="checkbox" name="equipment" value="full_gym">
            <span>🏢 Full Gym Access</span>
          </label>
          <label class="checkbox-label">
            <input type="checkbox" name="equipment" value="cardio_machine">
            <span>🚴‍♂️ Cardio Machine</span>
          </label>
          <label class="checkbox-label">
            <input type="checkbox" name="equipment" value="yoga_mat">
            <span>🧘 Yoga Mat</span>
          </label>
        </div>
      </div>

      <div class="form-section">
        <label>Days Per Week</label>
        <select id="daysPerWeek" required>
          <option value="">How many days can you workout?</option>
          <option value="2">2 days per week</option>
          <option value="3">3 days per week</option>
          <option value="4">4 days per week</option>
          <option value="5">5 days per week</option>
          <option value="6">6 days per week</option>
        </select>
      </div>

      <div class="form-section">
        <label>Session Duration (minutes)</label>
        <input type="number" id="sessionDuration" placeholder="e.g., 30, 45, 60" min="15" max="120" required>
      </div>

      <div class="form-section">
        <label>Health Conditions & Preferences</label>
        <div class="checkbox-group">
          <label class="checkbox-label">
            <input type="checkbox" name="health" value="diabetes">
            <span>🩺 Diabetes</span>
          </label>
          <label class="checkbox-label">
            <input type="checkbox" name="health" value="hypertension">
            <span>💓 High Blood Pressure</span>
          </label>
          <label class="checkbox-label">
            <input type="checkbox" name="health" value="heart_disease">
            <span>❤️ Heart Disease</span>
          </label>
          <label class="checkbox-label">
            <input type="checkbox" name="health" value="vegetarian">
            <span>🥬 Vegetarian</span>
          </label>
          <label class="checkbox-label">
            <input type="checkbox" name="health" value="vegan">
            <span>🌱 Vegan</span>
          </label>
          <label class="checkbox-label">
            <input type="checkbox" name="health" value="gluten_free">
            <span>🌾 Gluten-Free</span>
          </label>
        </div>
      </div>

      <div class="form-section">
        <label>Weight Goal</label>
        <select id="weightGoal" required>
          <option value="">Select your weight goal</option>
          <option value="lose">Lose Weight (1-2 lbs per week)</option>
          <option value="maintain">Maintain Current Weight</option>
          <option value="gain">Gain Weight (Healthy muscle gain)</option>
        </select>
      </div>

      <button type="submit" class="btn">Generate My Plan</button>
    </form>

    <div class="workout-plan" id="workoutPlan">
      <!-- Generated workout plan will appear here -->
    </div>

    <div class="workout-plan" id="mealPlan" style="display: none;">
      <!-- Generated meal plan will appear here -->
    </div>

    <div class="workout-plan" id="progressTracker" style="display: none;">
      <!-- Progress tracking will appear here -->
    </div>
  </div>

  <script>
    document.getElementById('workoutForm').addEventListener('submit', function(e) {
      e.preventDefault();
      generateWorkoutPlan();
    });

    function generateWorkoutPlan() {
      const fitnessLevel = document.getElementById('fitnessLevel').value;
      const daysPerWeek = parseInt(document.getElementById('daysPerWeek').value);
      const sessionDuration = parseInt(document.getElementById('sessionDuration').value);
      const weightGoal = document.getElementById('weightGoal').value;
      
      const goals = Array.from(document.querySelectorAll('input[name="goals"]:checked')).map(cb => cb.value);
      const equipment = Array.from(document.querySelectorAll('input[name="equipment"]:checked')).map(cb => cb.value);
      const health = Array.from(document.querySelectorAll('input[name="health"]:checked')).map(cb => cb.value);

      if (!fitnessLevel || !daysPerWeek || !sessionDuration || !weightGoal || goals.length === 0 || equipment.length === 0) {
        alert('Please fill in all fields to generate your personalized workout plan.');
        return;
      }

      const workoutPlan = createWorkoutPlan(fitnessLevel, goals, equipment, daysPerWeek, sessionDuration);
      const mealPlan = createMealPlan(weightGoal, health, goals);
      
      displayWorkoutPlan(workoutPlan);
      displayMealPlan(mealPlan);
      initializeProgressTracker(workoutPlan, mealPlan);
    }

    function createWorkoutPlan(level, goals, equipment, days, duration) {
      const exercises = {
        beginner: {
          strength: [
            { name: 'Push-ups (modified if needed)', sets: '2-3', reps: '8-12', equipment: 'none' },
            { name: 'Bodyweight Squats', sets: '2-3', reps: '10-15', equipment: 'none' },
            { name: 'Plank', sets: '2-3', reps: '20-30 seconds', equipment: 'none' },
            { name: 'Glute Bridges', sets: '2-3', reps: '12-15', equipment: 'none' }
          ],
          cardio: [
            { name: 'Walking', sets: '1', reps: '15-20 minutes', equipment: 'none' },
            { name: 'Marching in Place', sets: '3', reps: '30 seconds', equipment: 'none' },
            { name: 'Step-ups (using stairs)', sets: '2-3', reps: '10 each leg', equipment: 'none' }
          ]
        },
        intermediate: {
          strength: [
            { name: 'Push-ups', sets: '3-4', reps: '12-15', equipment: 'none' },
            { name: 'Goblet Squats', sets: '3-4', reps: '12-15', equipment: 'dumbbells' },
            { name: 'Dumbbell Rows', sets: '3-4', reps: '10-12', equipment: 'dumbbells' },
            { name: 'Lunges', sets: '3', reps: '10 each leg', equipment: 'none' },
            { name: 'Plank', sets: '3', reps: '45-60 seconds', equipment: 'none' }
          ],
          cardio: [
            { name: 'Burpees', sets: '3', reps: '8-10', equipment: 'none' },
            { name: 'Mountain Climbers', sets: '3', reps: '20-30', equipment: 'none' },
            { name: 'Jump Squats', sets: '3', reps: '12-15', equipment: 'none' }
          ]
        },
        advanced: {
          strength: [
            { name: 'Weighted Push-ups', sets: '4', reps: '12-15', equipment: 'dumbbells' },
            { name: 'Bulgarian Split Squats', sets: '4', reps: '12 each leg', equipment: 'dumbbells' },
            { name: 'Pull-ups/Chin-ups', sets: '4', reps: '8-12', equipment: 'full_gym' },
            { name: 'Deadlifts', sets: '4', reps: '8-10', equipment: 'dumbbells' },
            { name: 'Pike Push-ups', sets: '3', reps: '10-12', equipment: 'none' }
          ],
          cardio: [
            { name: 'HIIT Sprints', sets: '6', reps: '30s on, 30s rest', equipment: 'none' },
            { name: 'Burpee Box Jumps', sets: '4', reps: '8-10', equipment: 'none' },
            { name: 'Battle Ropes', sets: '4', reps: '30 seconds', equipment: 'full_gym' }
          ]
        }
      };

      const plan = {
        level: level,
        goals: goals,
        equipment: equipment,
        days: days,
        duration: duration,
        workouts: []
      };

      // Generate workouts based on goals and equipment availability
      const availableExercises = exercises[level];
      
      for (let day = 1; day <= days; day++) {
        const dayPlan = {
          day: day,
          exercises: []
        };

        if (goals.includes('strength') || goals.includes('muscle_gain')) {
          const strengthExercises = availableExercises.strength.filter(ex => 
            equipment.includes(ex.equipment) || ex.equipment === 'none'
          );
          dayPlan.exercises.push(...strengthExercises.slice(0, 4));
        }

        if (goals.includes('weight_loss') || goals.includes('endurance')) {
          const cardioExercises = availableExercises.cardio.filter(ex => 
            equipment.includes(ex.equipment) || ex.equipment === 'none'
          );
          dayPlan.exercises.push(...cardioExercises.slice(0, 2));
        }

        if (goals.includes('flexibility')) {
          dayPlan.exercises.push(
            { name: 'Dynamic Warm-up', sets: '1', reps: '5-10 minutes', equipment: 'none' },
            { name: 'Cool-down Stretching', sets: '1', reps: '10-15 minutes', equipment: 'yoga_mat' }
          );
        }

        plan.workouts.push(dayPlan);
      }

      return plan;
    }

    function displayWorkoutPlan(plan) {
      const planContainer = document.getElementById('workoutPlan');
      
      let html = `
        <h2>🎯 Your Personalized Workout Plan</h2>
        
        <div class="plan-summary">
          <h3>Plan Overview</h3>
          <p><strong>Level:</strong> ${plan.level.charAt(0).toUpperCase() + plan.level.slice(1)}</p>
          <p><strong>Frequency:</strong> ${plan.days} days per week</p>
          <p><strong>Duration:</strong> ${plan.duration} minutes per session</p>
          <p><strong>Goals:</strong> ${plan.goals.map(g => g.replace('_', ' ')).join(', ')}</p>
        </div>
      `;

      plan.workouts.forEach((workout, index) => {
        html += `
          <div class="workout-section">
            <h3>📅 Day ${workout.day} Workout</h3>
        `;
        
        workout.exercises.forEach(exercise => {
          html += `
            <div class="exercise-item">
              <div class="exercise-name">${exercise.name}</div>
              <div class="exercise-details">Sets: ${exercise.sets} | Reps: ${exercise.reps}</div>
            </div>
          `;
        });
        
        html += `</div>`;
      });

      html += `
        <div class="workout-section">
          <h3>💡 Tips for Success</h3>
          <div class="exercise-item">
            <div class="exercise-name">Warm-up</div>
            <div class="exercise-details">Always start with 5-10 minutes of light cardio or dynamic stretching</div>
          </div>
          <div class="exercise-item">
            <div class="exercise-name">Rest Between Sets</div>
            <div class="exercise-details">Rest 30-60 seconds for strength exercises, 15-30 seconds for cardio</div>
          </div>
          <div class="exercise-item">
            <div class="exercise-name">Progression</div>
            <div class="exercise-details">Increase intensity or reps by 10% each week as you get stronger</div>
          </div>
          <div class="exercise-item">
            <div class="exercise-name">Recovery</div>
            <div class="exercise-details">Take at least 1 rest day between intense workouts</div>
          </div>
        </div>
      `;

      planContainer.innerHTML = html;
      planContainer.style.display = 'block';
      planContainer.scrollIntoView({ behavior: 'smooth' });
    }

    function createMealPlan(weightGoal, health, goals) {
      const mealPlans = {
        lose: {
          calories: '1500-1800',
          protein: '120-140g',
          carbs: '150-200g',
          fats: '50-70g'
        },
        maintain: {
          calories: '1800-2200',
          protein: '100-120g',
          carbs: '200-250g',
          fats: '60-80g'
        },
        gain: {
          calories: '2200-2800',
          protein: '140-180g',
          carbs: '250-350g',
          fats: '70-90g'
        }
      };

      const meals = {
        breakfast: [
          { name: 'Oatmeal with Berries', calories: 300, protein: '10g', suitable: ['vegetarian', 'vegan'] },
          { name: 'Greek Yogurt with Nuts', calories: 250, protein: '20g', suitable: ['vegetarian'] },
          { name: 'Scrambled Eggs with Spinach', calories: 280, protein: '18g', suitable: ['vegetarian'] },
          { name: 'Protein Smoothie', calories: 320, protein: '25g', suitable: ['vegetarian', 'vegan'] }
        ],
        lunch: [
          { name: 'Grilled Chicken Salad', calories: 400, protein: '35g', suitable: [] },
          { name: 'Quinoa Buddha Bowl', calories: 450, protein: '15g', suitable: ['vegetarian', 'vegan'] },
          { name: 'Turkey Wrap', calories: 380, protein: '25g', suitable: [] },
          { name: 'Lentil Soup with Bread', calories: 420, protein: '18g', suitable: ['vegetarian', 'vegan'] }
        ],
        dinner: [
          { name: 'Baked Salmon with Vegetables', calories: 500, protein: '40g', suitable: [] },
          { name: 'Tofu Stir-fry', calories: 450, protein: '20g', suitable: ['vegetarian', 'vegan'] },
          { name: 'Lean Beef with Sweet Potato', calories: 520, protein: '45g', suitable: [] },
          { name: 'Chickpea Curry with Rice', calories: 480, protein: '16g', suitable: ['vegetarian', 'vegan'] }
        ],
        snacks: [
          { name: 'Apple with Almond Butter', calories: 180, protein: '6g', suitable: ['vegetarian', 'vegan'] },
          { name: 'Greek Yogurt', calories: 150, protein: '15g', suitable: ['vegetarian'] },
          { name: 'Trail Mix', calories: 200, protein: '8g', suitable: ['vegetarian', 'vegan'] },
          { name: 'Protein Bar', calories: 220, protein: '20g', suitable: ['vegetarian'] }
        ]
      };

      const avoidFoods = {
        diabetes: ['High sugar foods', 'White bread', 'Sugary drinks', 'Processed snacks'],
        hypertension: ['High sodium foods', 'Processed meats', 'Canned soups', 'Fast food'],
        heart_disease: ['Trans fats', 'Saturated fats', 'High cholesterol foods', 'Excessive salt'],
        gluten_free: ['Wheat', 'Barley', 'Rye', 'Most breads and pastas']
      };

      return {
        weightGoal,
        health,
        dailyIntake: mealPlans[weightGoal],
        meals,
        avoidFoods: health.filter(condition => avoidFoods[condition]).map(condition => ({
          condition,
          foods: avoidFoods[condition]
        }))
      };
    }

    function displayMealPlan(plan) {
      const planContainer = document.getElementById('mealPlan');
      
      let html = `
        <h2>🍽️ Your Personalized Meal Plan</h2>
        
        <div class="plan-summary">
          <h3>Daily Nutrition Targets</h3>
          <p><strong>Calories:</strong> ${plan.dailyIntake.calories} per day</p>
          <p><strong>Protein:</strong> ${plan.dailyIntake.protein} per day</p>
          <p><strong>Carbohydrates:</strong> ${plan.dailyIntake.carbs} per day</p>
          <p><strong>Fats:</strong> ${plan.dailyIntake.fats} per day</p>
        </div>
      `;

    
      Object.entries(plan.meals).forEach(([mealType, options]) => {
        const suitableMeals = options.filter(meal => 
          plan.health.length === 0 || 
          plan.health.some(condition => meal.suitable.includes(condition)) ||
          meal.suitable.length === 0
        );
        
        html += `
          <div class="workout-section">
            <h3>🍴 ${mealType.charAt(0).toUpperCase() + mealType.slice(1)} Options</h3>
        `;
        
        suitableMeals.slice(0, 2).forEach(meal => {
          html += `
            <div class="exercise-item">
              <div class="exercise-name">${meal.name}</div>
              <div class="exercise-details">${meal.calories} calories | ${meal.protein} protein</div>
            </div>
          `;
        });
        
        html += `</div>`;
      });

      // Foods to avoid
      if (plan.avoidFoods.length > 0) {
        html += `
          <div class="workout-section">
            <h3>⚠️ Foods to Limit or Avoid</h3>
        `;
        
        plan.avoidFoods.forEach(item => {
          html += `
            <div class="exercise-item">
              <div class="exercise-name">${item.condition.replace('_', ' ').toUpperCase()}</div>
              <div class="exercise-details">${item.foods.join(', ')}</div>
            </div>
          `;
        });
        
        html += `</div>`;
      }

      html += `
        <div class="workout-section">
          <h3>💡 Nutrition Tips</h3>
          <div class="exercise-item">
            <div class="exercise-name">Hydration</div>
            <div class="exercise-details">Drink 8-10 glasses of water daily</div>
          </div>
          <div class="exercise-item">
            <div class="exercise-name">Meal Timing</div>
            <div class="exercise-details">Eat every 3-4 hours to maintain energy levels</div>
          </div>
          <div class="exercise-item">
            <div class="exercise-name">Portion Control</div>
            <div class="exercise-details">Use smaller plates and listen to hunger cues</div>
          </div>
        </div>
      `;

      planContainer.innerHTML = html;
      planContainer.style.display = 'block';
    }

    function initializeProgressTracker(workoutPlan, mealPlan) {
      const progressData = {
        startDate: new Date().toDateString(),
        workoutsCompleted: 0,
        totalWorkouts: workoutPlan.days * 4, // 4 weeks
        currentWeek: 1,
        achievements: [],
        recommendations: []
      };

      displayProgressTracker(progressData, workoutPlan, mealPlan);
    }

    function displayProgressTracker(progress, workoutPlan, mealPlan) {
      const planContainer = document.getElementById('progressTracker');
      
      let html = `
        <h2>📅 Weekly Progress & Recommendations</h2>
        
        <div class="plan-summary">
          <h3>Progress Overview</h3>
          <p><strong>Start Date:</strong> ${progress.startDate}</p>
          <p><strong>Current Week:</strong> ${progress.currentWeek} of 4</p>
          <p><strong>Workouts Completed:</strong> ${progress.workoutsCompleted}/${progress.totalWorkouts}</p>
          <p><strong>Completion Rate:</strong> ${Math.round((progress.workoutsCompleted / progress.totalWorkouts) * 100)}%</p>
        </div>

        <div class="workout-section">
          <h3>🎯 This Week's Goals</h3>
          <div class="exercise-item">
            <div class="exercise-name">Complete ${workoutPlan.days} Workouts</div>
            <div class="exercise-details">Follow your personalized ${workoutPlan.duration}-minute sessions</div>
          </div>
          <div class="exercise-item">
            <div class="exercise-name">Follow Nutrition Plan</div>
            <div class="exercise-details">Stay within ${mealPlan.dailyIntake.calories} daily calories</div>
          </div>
          <div class="exercise-item">
            <div class="exercise-name">Track Progress</div>
            <div class="exercise-details">Log workouts and meals daily</div>
          </div>
        </div>

        <div class="workout-section">
          <h3>💪 Motivational Reminders</h3>
          <div class="exercise-item">
            <div class="exercise-name">Stay Consistent</div>
            <div class="exercise-details">Small daily actions lead to big results</div>
          </div>
          <div class="exercise-item">
            <div class="exercise-name">Listen to Your Body</div>
            <div class="exercise-details">Rest when needed, push when you can</div>
          </div>
          <div class="exercise-item">
            <div class="exercise-name">Celebrate Small Wins</div>
            <div class="exercise-details">Every workout completed is progress made</div>
          </div>
        </div>

        <div class="workout-section">
          <h3>📊 Weekly Recommendations</h3>
          <div class="exercise-item">
            <div class="exercise-name">Week 1: Foundation</div>
            <div class="exercise-details">Focus on form and establishing routine</div>
          </div>
          <div class="exercise-item">
            <div class="exercise-name">Week 2: Consistency</div>
            <div class="exercise-details">Maintain schedule, slight intensity increase</div>
          </div>
          <div class="exercise-item">
            <div class="exercise-name">Week 3: Challenge</div>
            <div class="exercise-details">Add 10% more reps or weight</div>
          </div>
          <div class="exercise-item">
            <div class="exercise-name">Week 4: Assessment</div>
            <div class="exercise-details">Evaluate progress and plan next phase</div>
          </div>
        </div>

        <div style="text-align: center; margin-top: 20px;">
          <button class="btn" onclick="logWorkout()" style="margin: 10px;">Log Today's Workout</button>
          <button class="btn" onclick="updateProgress()" style="margin: 10px;">Update Progress</button>
        </div>
      `;

      planContainer.innerHTML = html;
      planContainer.style.display = 'block';
    }

    function logWorkout() {
      alert('Workout logged! Keep up the great work! 💪');
      // In a real app, this would save to database
    }

    function updateProgress() {
      alert('Progress updated! Your dedication is showing results! 🎉');
      // In a real app, this would update progress metrics
    }

    // Enhanced checkbox interactions
    document.querySelectorAll('.checkbox-label').forEach(label => {
      const checkbox = label.querySelector('input[type="checkbox"]');
      
      label.addEventListener('click', (e) => {
        if (e.target !== checkbox) {
          checkbox.checked = !checkbox.checked;
          checkbox.dispatchEvent(new Event('change'));
        }
      });
      
      checkbox.addEventListener('change', () => {
        if (checkbox.checked) {
          label.style.background = 'rgba(255, 107, 107, 0.2)';
          label.style.borderColor = '#ff6b6b';
          label.style.boxShadow = '0 0 0 2px rgba(255, 107, 107, 0.3)';
        } else {
          label.style.background = 'rgba(255, 255, 255, 0.05)';
          label.style.borderColor = 'rgba(255, 255, 255, 0.1)';
          label.style.boxShadow = 'none';
        }
      });
    });
  </script>
</body>
</html>