<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>BMI & Body Stats - MX.Core</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      min-height: 100vh;
      background: linear-gradient(135deg, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0.4) 100%), url('https://images.unsplash.com/photo-1534438327276-14e5300c3a48?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1920&q=80');
      background-size: cover;
      background-position: center;
      background-attachment: fixed;
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      padding: 20px;
    }

    .main-container {
      text-align: center;
      z-index: 10;
      max-width: 800px;
      width: 100%;
      padding: 40px;
      backdrop-filter: blur(10px);
      background: rgba(255, 255, 255, 0.1);
      border-radius: 24px;
      border: 1px solid rgba(255, 255, 255, 0.2);
      box-shadow: 0 25px 50px rgba(0, 0, 0, 0.3);
      animation: fadeInUp 1s ease-out;
    }

    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(30px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .logo {
      font-size: 3rem;
      margin-bottom: 10px;
      animation: pulse 2s infinite;
    }

    @keyframes pulse {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.05); }
    }

    h1 {
      font-size: 2.8rem;
      font-weight: 800;
      margin-bottom: 20px;
      background: linear-gradient(135deg, #fff 0%, #f0f0f0 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      line-height: 1.2;
      text-shadow: 0 4px 8px rgba(0, 0, 0, 0.3);
    }

    .subtitle {
      font-size: 1.2rem;
      margin-bottom: 40px;
      color: rgba(255, 255, 255, 0.9);
      font-weight: 300;
      line-height: 1.6;
      max-width: 600px;
      margin-left: auto;
      margin-right: auto;
    }

    .form-container {
      background: linear-gradient(145deg, rgba(255, 255, 255, 0.15) 0%, rgba(255, 255, 255, 0.05) 100%);
      border-radius: 24px;
      padding: 40px;
      margin-bottom: 30px;
      border: 2px solid rgba(255, 255, 255, 0.1);
      backdrop-filter: blur(20px);
      box-shadow: 
        0 20px 40px rgba(0, 0, 0, 0.2),
        inset 0 1px 0 rgba(255, 255, 255, 0.2);
      position: relative;
      overflow: hidden;
    }

    .form-container::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.05), transparent);
      animation: shimmer 3s infinite;
    }

    @keyframes shimmer {
      0% { left: -100%; }
      100% { left: 100%; }
    }

    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 30px;
      margin-bottom: 35px;
    }

    .form-group {
      position: relative;
      text-align: left;
    }

    .input-wrapper {
      position: relative;
      overflow: hidden;
      border-radius: 16px;
    }

    label {
      display: block;
      margin-bottom: 12px;
      font-weight: 700;
      color: rgba(255, 255, 255, 0.95);
      font-size: 1.1rem;
      letter-spacing: 0.5px;
      text-transform: uppercase;
    }

    input[type="text"] {
      width: 100%;
      padding: 20px 25px;
      border: 2px solid rgba(255, 255, 255, 0.15);
      border-radius: 16px;
      background: linear-gradient(145deg, rgba(255, 255, 255, 0.1) 0%, rgba(255, 255, 255, 0.05) 100%);
      color: white;
      font-size: 1.2rem;
      font-weight: 600;
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      backdrop-filter: blur(10px);
      position: relative;
      z-index: 2;
    }

    input[type="text"]:focus {
      outline: none;
      border-color: rgba(255, 107, 107, 0.8);
      background: linear-gradient(145deg, rgba(255, 255, 255, 0.2) 0%, rgba(255, 255, 255, 0.1) 100%);
      transform: translateY(-2px) scale(1.02);
      box-shadow: 
        0 15px 35px rgba(255, 107, 107, 0.3),
        0 5px 15px rgba(0, 0, 0, 0.1),
        inset 0 1px 0 rgba(255, 255, 255, 0.2);
    }

    input[type="text"]::placeholder {
      color: rgba(255, 255, 255, 0.5);
      font-weight: 400;
    }

    /* Premium floating labels effect */
    .floating-label {
      position: absolute;
      top: 50%;
      left: 25px;
      transform: translateY(-50%);
      color: rgba(255, 255, 255, 0.6);
      font-size: 1.1rem;
      font-weight: 500;
      pointer-events: none;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      z-index: 3;
    }

    input[type="text"]:focus + .floating-label,
    input[type="text"]:not(:placeholder-shown) + .floating-label {
      top: -8px;
      left: 15px;
      font-size: 0.85rem;
      color: #ff6b6b;
      font-weight: 700;
      background: linear-gradient(90deg, rgba(0,0,0,0.8) 0%, rgba(0,0,0,0.6) 100%);
      padding: 4px 8px;
      border-radius: 8px;
    }

    /* Premium input icons */
    .input-icon {
      position: absolute;
      right: 20px;
      top: 50%;
      transform: translateY(-50%);
      font-size: 1.3rem;
      color: rgba(255, 255, 255, 0.4);
      z-index: 3;
      transition: all 0.3s ease;
    }

    input[type="text"]:focus ~ .input-icon {
      color: #ff6b6b;
      transform: translateY(-50%) scale(1.1);
    }

    .calculate-button {
      background: linear-gradient(135deg, #ff6b6b 0%, #ee5a24 50%, #ff6b6b 100%);
      background-size: 200% 200%;
      color: white;
      padding: 22px 60px;
      border: none;
      border-radius: 50px;
      font-size: 1.3rem;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
      text-transform: uppercase;
      letter-spacing: 2px;
      box-shadow: 
        0 20px 40px rgba(255, 107, 107, 0.4),
        0 5px 15px rgba(0, 0, 0, 0.1),
        inset 0 1px 0 rgba(255, 255, 255, 0.2);
      position: relative;
      overflow: hidden;
      width: 100%;
      max-width: 350px;
      margin-top: 15px;
      animation: buttonGlow 2s ease-in-out infinite alternate;
    }

    @keyframes buttonGlow {
      0% { background-position: 0% 50%; }
      100% { background-position: 100% 50%; }
    }

    .calculate-button::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
      transition: left 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .calculate-button:hover::before {
      left: 100%;
    }

    .calculate-button:hover {
      transform: translateY(-4px) scale(1.05);
      box-shadow: 
        0 25px 50px rgba(255, 107, 107, 0.6),
        0 10px 25px rgba(0, 0, 0, 0.2),
        inset 0 1px 0 rgba(255, 255, 255, 0.3);
      background: linear-gradient(135deg, #ff5252 0%, #d63031 50%, #ff5252 100%);
    }

    .calculate-button:active {
      transform: translateY(-2px) scale(1.02);
      transition: all 0.1s ease;
    }

    /* Premium progress indicators */
    .form-progress {
      display: flex;
      justify-content: center;
      align-items: center;
      margin-bottom: 25px;
      gap: 10px;
    }

    .progress-dot {
      width: 12px;
      height: 12px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.3);
      transition: all 0.3s ease;
    }

    .progress-dot.active {
      background: linear-gradient(135deg, #ff6b6b, #ee5a24);
      box-shadow: 0 0 15px rgba(255, 107, 107, 0.6);
      transform: scale(1.2);
    }

    .results-container {
      background: rgba(255, 255, 255, 0.15);
      border-radius: 20px;
      padding: 30px;
      margin: 30px 0;
      border: 1px solid rgba(255, 255, 255, 0.2);
      backdrop-filter: blur(10px);
      animation: slideInUp 0.6s ease-out;
    }

    @keyframes slideInUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .results-container h2 {
      font-size: 1.8rem;
      margin-bottom: 20px;
      color: white;
      font-weight: 700;
    }

    .bmi-result {
      font-size: 4rem;
      font-weight: 800;
      margin: 20px 0;
      background: linear-gradient(135deg, #fff 0%, #f0f0f0 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      text-shadow: 0 4px 8px rgba(0, 0, 0, 0.3);
    }

    .bmi-status {
      font-size: 1.5rem;
      font-weight: 600;
      padding: 15px 30px;
      border-radius: 50px;
      margin: 20px 0;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .status-underweight {
      background: linear-gradient(135deg, #74b9ff 0%, #0984e3 100%);
      box-shadow: 0 10px 25px rgba(116, 185, 255, 0.4);
    }

    .status-normal {
      background: linear-gradient(135deg, #00b894 0%, #00a085 100%);
      box-shadow: 0 10px 25px rgba(0, 184, 148, 0.4);
    }

    .status-overweight {
      background: linear-gradient(135deg, #fdcb6e 0%, #e17055 100%);
      box-shadow: 0 10px 25px rgba(253, 203, 110, 0.4);
    }

    .status-obese {
      background: linear-gradient(135deg, #e17055 0%, #d63031 100%);
      box-shadow: 0 10px 25px rgba(225, 112, 85, 0.4);
    }

    .nav-links {
      margin-top: 30px;
    }

    .nav-links a {
      background: linear-gradient(135deg, #6c5ce7 0%, #5f3dc4 100%);
      color: white;
      padding: 15px 40px;
      text-decoration: none;
      border-radius: 50px;
      font-size: 1.1rem;
      font-weight: 600;
      transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
      text-transform: uppercase;
      letter-spacing: 1px;
      box-shadow: 0 12px 25px rgba(108, 92, 231, 0.4);
      display: inline-block;
      position: relative;
      overflow: hidden;
    }

    .nav-links a::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
      transition: left 0.5s;
    }

    .nav-links a:hover::before {
      left: 100%;
    }

    .nav-links a:hover {
      transform: translateY(-3px) scale(1.05);
      box-shadow: 0 18px 35px rgba(108, 92, 231, 0.6);
      background: linear-gradient(135deg, #5f39cc 0%, #4c3499 100%);
    }

    /* Floating particles animation */
    .particle {
      position: absolute;
      background: rgba(255, 255, 255, 0.1);
      border-radius: 50%;
      pointer-events: none;
      animation: float 6s ease-in-out infinite;
    }

    @keyframes float {
      0%, 100% { transform: translateY(0px) rotate(0deg); }
      50% { transform: translateY(-20px) rotate(180deg); }
    }

    .particle:nth-child(1) { top: 20%; left: 20%; width: 10px; height: 10px; animation-delay: 0s; }
    .particle:nth-child(2) { top: 80%; left: 80%; width: 15px; height: 15px; animation-delay: 2s; }
    .particle:nth-child(3) { top: 40%; left: 70%; width: 8px; height: 8px; animation-delay: 4s; }

    /* Enhanced Mobile Responsiveness */
    @media (max-width: 768px) {
      body {
        background-attachment: scroll;
        padding: 10px;
        min-height: 100vh;
        align-items: flex-start;
        padding-top: 40px;
      }
      
      .main-container {
        margin: 0;
        padding: 30px 25px;
        border-radius: 20px;
        max-width: 100%;
      }
      
      .logo {
        font-size: 2.5rem;
        margin-bottom: 15px;
      }
      
      h1 {
        font-size: 2.2rem;
        margin-bottom: 15px;
        line-height: 1.1;
      }
      
      .subtitle {
        font-size: 1.1rem;
        margin-bottom: 30px;
        padding: 0 10px;
      }

      .form-row {
        grid-template-columns: 1fr;
        gap: 20px;
      }

      .form-container {
        padding: 30px 20px;
      }

      input[type="text"] {
        padding: 18px 20px;
        font-size: 1.1rem;
      }

      .calculate-button {
        padding: 18px 45px;
        font-size: 1.2rem;
        max-width: 320px;
        letter-spacing: 1px;
      }

      .bmi-result {
        font-size: 3rem;
      }

      .bmi-status {
        font-size: 1.2rem;
        padding: 12px 25px;
      }

      .nav-links a {
        padding: 12px 30px;
        font-size: 1rem;
      }
    }

    /* Extra small screens */
    @media (max-width: 480px) {
      body {
        padding: 15px 10px;
        padding-top: 30px;
      }
      
      .main-container {
        padding: 25px 20px;
        border-radius: 16px;
      }
      
      .logo {
        font-size: 2rem;
        margin-bottom: 12px;
      }
      
      h1 {
        font-size: 1.8rem;
        margin-bottom: 12px;
      }
      
      .subtitle {
        font-size: 1rem;
        margin-bottom: 25px;
        padding: 0 5px;
      }

      .form-container {
        padding: 25px 15px;
      }

      input[type="text"] {
        padding: 16px 18px;
        font-size: 1rem;
      }

      label {
        font-size: 1rem;
      }

      .calculate-button {
        padding: 16px 40px;
        font-size: 1.1rem;
        max-width: 100%;
        letter-spacing: 1px;
      }

      .bmi-result {
        font-size: 2.5rem;
      }

      .bmi-status {
        font-size: 1.1rem;
        padding: 10px 20px;
      }

      .nav-links a {
        padding: 10px 25px;
        font-size: 0.95rem;
      }
    }

    /* Touch device optimizations */
    @media (pointer: coarse) {
      .calculate-button, .nav-links a {
        min-height: 48px;
      }
      
      input[type="text"] {
        min-height: 48px;
      }
    }
  </style>
</head>
<body>
  <!-- Floating particles -->
  <div class="particle"></div>
  <div class="particle"></div>
  <div class="particle"></div>

  <div class="main-container">
    <div class="logo">📊</div>
    <h1>BMI & Body Stats</h1>
    <p class="subtitle">Calculate your Body Mass Index and get personalized insights for your fitness journey.</p>

    <div class="form-container">
      <div class="form-progress">
       
      </div>

      <form action="/bmi-stats" method="POST">
        <div class="form-row">
          <div class="form-group">
            <label for="weight">Weight</label>
            <div class="input-wrapper">
              <input type="text" id="weight" name="weight" required placeholder=" ">
              <div class="floating-label">Enter your weight</div>
             
            </div>
          </div>

          <div class="form-group">
            <label for="height">Height</label>
            <div class="input-wrapper">
              <input type="text" id="height" name="height" required placeholder=" ">
              <div class="floating-label">Enter your height</div>
             
            </div>
          </div>
        </div>

        <button class="calculate-button" type="submit">Calculate BMI</button>
      </form>
    </div>

    <!-- Results Section (EJS Template) -->
    <% if (typeof bmi !== 'undefined' && typeof status !== 'undefined') { %>
    <div class="results-container" id="results">
      <h2>Your BMI Results</h2>
      <div class="bmi-result"><%= bmi %></div>
      <div class="bmi-status 
        <%= status === 'Underweight' ? 'status-underweight' : 
             status === 'Normal Weight' ? 'status-normal' : 
             status === 'Overweight' ? 'status-overweight' : 
             'status-obese' %>">
        <%= status %>
      </div>
    </div>

    <div class="nav-links">
      <a href="/medical-check">Continue Journey</a>
    </div>
    <% } %>
  </div>

  <script>
    // Premium form interactions
    document.addEventListener('DOMContentLoaded', function() {
      const inputs = document.querySelectorAll('input[type="text"]');
      const progressDots = document.querySelectorAll('.progress-dot');
      
      inputs.forEach((input, index) => {
        input.addEventListener('input', function() {
          if (this.value) {
            progressDots[index + 1]?.classList.add('active');
          } else {
            progressDots[index + 1]?.classList.remove('active');
          }
        });

        // Add ripple effect on focus
        input.addEventListener('focus', function() {
          this.parentElement.style.transform = 'scale(1.02)';
        });

        input.addEventListener('blur', function() {
          this.parentElement.style.transform = 'scale(1)';
        });
      });

      // Form validation with premium feedback
      const form = document.querySelector('form');
      form.addEventListener('submit', function(e) {
        const weight = document.getElementById('weight').value;
        const height = document.getElementById('height').value;

        if (!weight || !height) {
          e.preventDefault();
          // Add shake animation to empty fields
          inputs.forEach(input => {
            if (!input.value) {
              input.style.animation = 'shake 0.5s ease-in-out';
              setTimeout(() => {
                input.style.animation = '';
              }, 500);
            }
          });
        }
      });
    });

    // Add shake animation
    const style = document.createElement('style');
    style.textContent = `
      @keyframes shake {
        0%, 100% { transform: translateX(0); }
        25% { transform: translateX(-5px); }
        75% { transform: translateX(5px); }
      }
    `;
    document.head.appendChild(style);
  </script>
</body>
</html>